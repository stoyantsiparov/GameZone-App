@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="navbar-nav">
	@if (SignInManager.IsSignedIn(User))
	{
		<li class="nav-item d-flex align-items-center">
			<a id="manage" class="nav-link text-warning fw-bold px-3" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage" style="font-size: 1.1rem;">
				👤 @UserManager.GetUserName(User)
			</a>
		</li>
    
		<li class="nav-item d-flex align-items-center ms-2">
			<form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })">
				<button id="logout" type="submit" class="btn btn-danger btn-sm fw-bold text-white px-3 shadow-sm">
					🚪 Изход
				</button>
			</form>
		</li>
	}
	else
	{
		<li class="nav-item">
			<a class="nav-link text-white fw-bold" id="register" asp-area="Identity" asp-page="/Account/Register">✍️ Регистрация</a>
		</li>
		<li class="nav-item ms-2">
			<a class="btn btn-light btn-sm fw-bold text-dark mt-1 px-3" id="login" asp-area="Identity" asp-page="/Account/Login">🔑 Вход</a>
		</li>
	}
</ul>