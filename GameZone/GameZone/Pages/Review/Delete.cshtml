@page
@model GameZone.Pages.Review.DeleteModel

@{
	ViewData["Title"] = "Изтриване на ревю";
}

<div class="row justify-content-center mt-4">
	<div class="col-md-6">
		<div class="card shadow border-danger">
			<div class="card-header bg-danger text-white">
				<h3 class="mb-0">🗑️ Изтриване на ревю</h3>
			</div>
			<div class="card-body text-center">
				<div class="alert alert-warning">
					Сигурни ли сте, че искате да изтриете ревюто на <strong>@Html.DisplayFor(m => m.Review.UserName)</strong>?
				</div>

				<div class="card bg-light mb-3">
					<div class="card-body fst-italic">
						"@Html.DisplayFor(model => model.Review.Content)"
					</div>
				</div>
                
				<form method="post">
					<input type="hidden" asp-for="Review.Id" />
					<button type="submit" class="btn btn-danger btn-lg px-5">Да, Изтрий</button>
					<br />
					<a asp-page="./Index" class="btn btn-link text-secondary mt-2">Отказ</a>
				</form>
			</div>
		</div>
	</div>
</div>