@page
@model GameZone.Pages.Review.EditModel

@{
	ViewData["Title"] = "Редакция на ревю";
}

<div class="row justify-content-center mt-4">
	<div class="col-md-6">
		<div class="card shadow border-warning">
			<div class="card-header bg-warning text-dark">
				<h3 class="mb-0">✏️ Редакция на ревю</h3>
			</div>
			<div class="card-body">
				<form method="post">
					<div asp-validation-summary="ModelOnly" class="text-danger"></div>
					<input type="hidden" asp-for="Review.Id" />
					<input type="hidden" asp-for="Review.GameId" />
					<input type="hidden" asp-for="Review.UserName" />
					<input type="hidden" asp-for="Review.CreatedAt" />

					<div class="form-group mb-3">
						<label class="fw-bold">Оценка (1-10):</label>
						<select asp-for="Review.Rating" class="form-select">
							@for(int i=1; i<=10; i++){ <option value="@i">@i</option> }
						</select>
					</div>

					<div class="form-group mb-4">
						<label class="fw-bold">Коментар:</label>
						<textarea asp-for="Review.Content" class="form-control" rows="4"></textarea>
						<span asp-validation-for="Review.Content" class="text-danger"></span>
					</div>

					<div class="d-grid gap-2">
						<input type="submit" value="💾 Запази промените" class="btn btn-warning btn-lg shadow-sm" />
						<a asp-page="./Index" class="btn btn-outline-secondary">Отказ</a>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>

@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }