@page
@model GameZone.Pages.Developer.IndexModel

@{
    ViewData["Title"] = "Студиа";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>🏢 Всички Студиа</h1>
    @if (User.Identity!.IsAuthenticated)
    {
        <a asp-page="Create" class="btn btn-primary">➕ Добави ново студио</a>
    }
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover table-striped mb-0">
            <thead class="table-dark">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Developer[0].Name)</th>
                    <th>@Html.DisplayNameFor(model => model.Developer[0].Website)</th>

                    @if (User.Identity!.IsAuthenticated)
                    {
                        <th class="text-end">Действия</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Developer)
                {
                    <tr>
                        <td class="fw-bold">@Html.DisplayFor(modelItem => item.Name)</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Website))
                            {
                                <a href="@item.Website" target="_blank" class="text-decoration-none">🌐 @Html.DisplayFor(modelItem => item.Website)</a>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>

                        @if (User.Identity!.IsAuthenticated)
                        {
                            <td class="text-end">
                                <div class="btn-group" role="group">
	                                <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Редактирай</a>
	                                <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Изтрий</a>
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>