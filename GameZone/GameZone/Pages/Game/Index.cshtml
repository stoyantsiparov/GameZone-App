@page
@model GameZone.Pages.Game.IndexModel

@{
    ViewData["Title"] = "Каталог";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>🎮 Каталог с игри</h1>
    @if (User.Identity!.IsAuthenticated)
    {
        <a asp-page="Create" class="btn btn-primary">➕ Добави нова игра</a>
    }
</div>

<!-- ФОРМА ЗА ТЪРСЕНЕ И ФИЛТРИРАНЕ -->
<div class="card mb-4 shadow-sm bg-light">
    <div class="card-body">
        <form asp-page="./Index" method="get">
            <div class="row g-3 align-items-center">
                <div class="col-auto">
                    <label class="fw-bold">Жанр:</label>
                </div>
                <div class="col-auto">
                    <select asp-for="CurrentGenre" asp-items="Model.Genres" class="form-select">
                        <option value="">Всички</option>
                    </select>
                </div>
                <div class="col-auto">
                    <label class="fw-bold">Заглавие:</label>
                </div>
                <div class="col-auto">
                    <input type="text" name="SearchString" value="@Model.CurrentFilter" class="form-control" placeholder="Търси..." />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">🔍 Търси</button>
                    <a asp-page="./Index" class="btn btn-outline-secondary">Изчисти</a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- ТАБЛИЦА С ИГРИ -->
<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover table-striped mb-0 align-middle">
            <thead class="table-dark">
                <tr>
                    <th style="width: 100px;">Снимка</th>

                    <!-- ЗАГЛАВИЕ СЪС СТРЕЛКИ -->
                    <th>
                        <a asp-page="./Index"
                           asp-route-sortOrder="@Model.TitleSort"
                           asp-route-currentFilter="@Model.CurrentFilter"
                           asp-route-currentGenre="@Model.CurrentGenre"
                           class="text-white text-decoration-none">
                            Заглавие
                            @if (string.IsNullOrEmpty(Model.CurrentSort))
                            {
                                <span>▼</span>
                            }
                            else if (Model.CurrentSort == "title_desc")
                            {
                                <span>▲</span>
                            }
                            else
                            {
                                <span class="text-white-50">⇅</span>
                            }
                        </a>
                    </th>

                    <!-- ДАТА СЪС СТРЕЛКИ -->
                    <th>
                        <a asp-page="./Index"
                           asp-route-sortOrder="@Model.DateSort"
                           asp-route-currentFilter="@Model.CurrentFilter"
                           asp-route-currentGenre="@Model.CurrentGenre"
                           class="text-white text-decoration-none">
                            Дата
                            @if (Model.CurrentSort == "Date")
                            {
                                <span>▼</span>
                            }
                            else if (Model.CurrentSort == "date_desc")
                            {
                                <span>▲</span>
                            }
                            else
                            {
                                <span class="text-white-50">⇅</span>
                            }
                        </a>
                    </th>

                    <!-- ЦЕНА СЪС СТРЕЛКИ -->
                    <th>
                        <a asp-page="./Index"
                           asp-route-sortOrder="@Model.PriceSort"
                           asp-route-currentFilter="@Model.CurrentFilter"
                           asp-route-currentGenre="@Model.CurrentGenre"
                           class="text-white text-decoration-none">
                            Цена
                            @if (Model.CurrentSort == "Price")
                            {
                                <span>▲</span>
                            }
                            else if (Model.CurrentSort == "price_desc")
                            {
                                <span>▼</span>
                            }
                            else
                            {
                                <span class="text-white-50">⇅</span>
                            }
                        </a>
                    </th>

                    <th>Жанр</th>
                    <th>Платформа</th>
                    <th>Студио</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Game)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.Title" class="rounded shadow-sm" style="width: 60px; height: 80px; object-fit: cover;" />
                            }
                            else
                            {
                                <span class="text-muted small">Няма</span>
                            }
                        </td>
                        <td class="fw-bold">
                            <a asp-page="./Details" asp-route-id="@item.Id" class="text-decoration-none text-dark">
                                @Html.DisplayFor(modelItem => item.Title)
                            </a>
                        </td>
                        <td>@item.ReleaseDate.ToShortDateString()</td>
                        <td>@Html.DisplayFor(modelItem => item.Price) лв.</td>
                        <td><span class="badge bg-secondary">@Html.DisplayFor(modelItem => item.Genre!.Name)</span></td>
                        <td>@Html.DisplayFor(modelItem => item.Platform!.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.Developer!.Name)</td>
                        <td class="text-end">
                            @if (User.Identity!.IsAuthenticated)
                            {
                                <div class="btn-group" role="group">
                                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Редактирай</a>
                                    <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Изтрий</a>
                                </div>
                            }
                            else
                            {
                                <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Виж</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- АКО НЯМА НАМЕРЕНИ ИГРИ -->
@if (!Model.Game.Any())
{
    <div class="alert alert-warning text-center mt-3 shadow-sm" role="alert">
        <h4 class="alert-heading">😕 Няма намерени игри!</h4>
        <p>Опитайте да промените критериите за търсене или избрания жанр.</p>
        <hr>
        <a asp-page="./Index" class="btn btn-outline-dark btn-sm">🔄 Покажи всички игри</a>
    </div>
}

<!-- БУТОНИ ЗА СТРАНИРАНЕ -->
@{
    var prevDisabled = !Model.Game.HasPreviousPage ? "disabled" : "";
    var nextDisabled = !Model.Game.HasNextPage ? "disabled" : "";
}

<div class="mt-3 text-center">
    <a asp-page="./Index"
       asp-route-sortOrder="@Model.CurrentSort"
       asp-route-pageIndex="@(Model.Game.PageIndex - 1)"
       asp-route-currentFilter="@Model.CurrentFilter"
       asp-route-currentGenre="@Model.CurrentGenre"
       class="btn btn-outline-primary @prevDisabled">
        ⬅️ Предишна
    </a>

    <span class="mx-2 fw-bold text-muted">Страница @Model.Game.PageIndex от @Model.Game.TotalPages</span>

    <a asp-page="./Index"
       asp-route-sortOrder="@Model.CurrentSort"
       asp-route-pageIndex="@(Model.Game.PageIndex + 1)"
       asp-route-currentFilter="@Model.CurrentFilter"
       asp-route-currentGenre="@Model.CurrentGenre"
       class="btn btn-outline-primary @nextDisabled">
        Следваща ➡️
    </a>
</div>